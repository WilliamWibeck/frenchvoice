{
  "name": "french-voice-practice",
  "version": "2.0.0",
  "description": "Voice-to-voice French speaking practice using the Gemini Live API (Vite + React)",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n API,VITE -c blue,green \"npm:dev:api\" \"npm:dev:vite\"",
    "dev:api": "node api-dev-server.js",
    "dev:vite": "vite",
    "build": "vite build",
    "preview": "concurrently -k -n API,PREVIEW -c blue,green \"npm:dev:api\" \"vite preview\""
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@google/genai": "^2.18.0",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^8.2.2",
    "vite": "^5.4.0"
  }
}
